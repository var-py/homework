# Скопируйте этот файл в .env перед запуском: cp .env.example .env
# .env НЕ коммитится в репозиторий — в CI/CD переменные подставляются из секретов.

# URL для SQLAlchemy. Хост "db" — это имя сервиса в docker-compose,
# session.py при необходимости заменяет его на значение DB_HOST.
POSTGRESS_URL=postgresql+psycopg2://flask_user:flask_password@db:5432/postgres

# Параметры подключения к PostgreSQL
DB_HOST=db
DB_NAME=postgres
DB_USER=flask_user
DB_PASSWORD=flask_password
DB_PORT=5432

# --- DeepSeek (ИИ-агент, app/ai_agent.py) ---
# Ключ берётся с https://platform.deepseek.com/api_keys. Не коммитьте реальный ключ.
DEEPSEEK_API_KEY=
# Необязательно: адрес API и модель (по умолчанию deepseek-chat).
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
